# Precious AI — environment variables (server-side only).
# Copy to .env for local/dev use (git-ignored). On Vercel, set these in
# Project Settings -> Environment Variables instead. NEVER commit real keys.

# --- LLM provider key (pick the one you use) ---
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# --- persistent storage backend ---
# "sqlite" (default) -> file database; on Vercel it lives in /tmp and is
#                        EPHEMERAL (lost on instance recycle)
# "postgres"         -> external Postgres; REQUIRED for durable data on Vercel
PA_STORAGE=sqlite
# PA_DATABASE_URL=postgres://user:password@host:5432/precious?sslmode=require

# --- runtime data directory (optional overrides) ---
# Default: <project>/data locally; /tmp/precious-ai on Vercel
# PA_DATA_DIR=
# Cache dir for the local embedding model (default: <data dir>/models)
# PA_MODEL_CACHE_DIR=

# --- split hosting: let a separately hosted UI call this API ---
# PA_CORS_ORIGINS=https://your-ui.vercel.app
